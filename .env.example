# App
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="ChemPlay Classroom - Học Hóa cùng cô Hằng"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chemplay?schema=public"

# Auth
AUTH_SECRET="replace-with-strong-secret"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# Seed accounts
SEED_ADMIN_USERNAME="NguyenHang"
SEED_ADMIN_PASSWORD="2109@Hangyp"
SEED_TEACHER_USERNAME="BacNinh"
SEED_TEACHER_PASSWORD="BacNinh@9899"

# Storage (S3 compatible)
S3_REGION="auto"
S3_BUCKET="chemplay-media"
S3_ENDPOINT="https://example.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="replace-access-key"
S3_SECRET_ACCESS_KEY="replace-secret-key"

# Upload limits (bytes)
MAX_IMAGE_SIZE=5242880
MAX_VIDEO_SIZE=52428800
MAX_AUDIO_SIZE=20971520
